    async function tryStartWebRtcStream(mode) {
      stopCameraStream();
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        return false;
      }

      const videoEl = document.getElementById('cameraVideo');
      const withAudio = (mode === 'video');

      try {
        cameraMediaStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: currentFacingMode }, width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: withAudio
        });
      } catch (err) {
        try {
          cameraMediaStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: { ideal: currentFacingMode } },
            audio: false
          });
        } catch (e2) {
          try {
            cameraMediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
          } catch (e3) {
            return false;
          }
        }
      }

      if (cameraMediaStream && videoEl) {
        document.getElementById('cameraModal').classList.add('active');
        try { history.pushState({ modal: 'camera' }, ''); } catch(e){}
        videoEl.srcObject = cameraMediaStream;
        videoEl.muted = true;
        videoEl.setAttribute('playsinline', 'true');
        videoEl.setAttribute('autoplay', 'true');
        try { 
          await videoEl.play(); 
        } catch(e) {}
        return true;
      }
      return false;
    }

    function stopCameraStream() {
      if (cameraMediaStream) {
        cameraMediaStream.getTracks().forEach(t => t.stop());
        cameraMediaStream = null;
      }
      const videoEl = document.getElementById('cameraVideo');
      if (videoEl) videoEl.srcObject = null;
      document.getElementById('cameraModal').classList.remove('active');
    }

    function captureSquarePhotoFromStream() {
      const video = document.getElementById('cameraVideo');
      if (!video) {
        showToast('Kamera tidak ditemui!');
        return;
      }

      const vw = video.videoWidth || 640;
      const vh = video.videoHeight || 480;
      const size = Math.min(vw, vh);

      const canvas = document.createElement('canvas');
      canvas.width = 600;
      canvas.height = 600;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, (vw - size) / 2, (vh - size) / 2, size, size, 0, 0, 600, 600);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.88);
      if (attachedPhotos.length < 10) {
        attachedPhotos.push(dataUrl);
        currentPhotoCursorIndex = attachedPhotos.length - 1;
        updatePhotoDropdown();
        stopCameraStream();
        showToast(`Foto 1:1 berjaya ditangkap (${attachedPhotos.length}/10)!`);
      } else {
        showToast('Slot foto telah mencapai had 10 keping!');
      }
    }

    function handleImageFiles(fileList) {
      if (!fileList || !fileList.length) return;
      const available = 10 - attachedPhotos.length;
      if (available <= 0) {
        showToast('Slot 10 keping foto sudah penuh!');
        return;
      }
      const files = Array.from(fileList).slice(0, available);
      let count = 0;
      files.forEach(f => {
        const r = new FileReader();
        r.onload = (ev) => {
          cropImageFileToSquare(ev.target.result, (croppedDataUrl) => {
            attachedPhotos.push(croppedDataUrl);
            currentPhotoCursorIndex = attachedPhotos.length - 1;
            count++;
            if (count === files.length) {
              updatePhotoDropdown();
              showToast(`${files.length} foto berjaya dilampirkan (${attachedPhotos.length}/10).`);
            }
          });
        };
        r.readAsDataURL(f);
      });
    }

    function cropImageFileToSquare(dataUrl, callback) {
      const img = new Image();
      img.onload = () => {
        const size = Math.min(img.width, img.height);
        const canvas = document.createElement('canvas');
        canvas.width = 600;
        canvas.height = 600;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, (img.width - size) / 2, (img.height - size) / 2, size, size, 0, 0, 600, 600);
        callback(canvas.toDataURL('image/jpeg', 0.88));
      };
      img.src = dataUrl;
    }

