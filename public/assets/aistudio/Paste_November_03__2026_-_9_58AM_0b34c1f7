    function updatePrayerDisplay(timings, label) {
      const now = new Date();
      const list = [
        { k: 'Fajr', l: 'Subuh' }, { k: 'Sunrise', l: 'Syuruk' }, { k: 'Dhuhr', l: 'Zohor' },
        { k: 'Asr', l: 'Asar' }, { k: 'Maghrib', l: 'Maghrib' }, { k: 'Isha', l: 'Isyak' }
      ];
      let nextP = null;
      for (let p of list) {
        if (timings[p.k]) {
          const [h, m] = timings[p.k].split(' ')[0].split(':').map(Number);
          const pD = new Date();
          pD.setHours(h, m, 0, 0);
          if (pD > now) {
            nextP = { ...p, time: timings[p.k].split(' ')[0], diff: Math.floor((pD - now) / 60000) };
            break;
          }
        }
      }
      if (!nextP) nextP = { l: 'Subuh', time: timings.Fajr.split(' ')[0], diff: 360 };
      document.getElementById('nextPrayerName').textContent = nextP.l;
      document.getElementById('nextPrayerTime').textContent = nextP.time;
      document.getElementById('prayerCountdownDesc').textContent = `${Math.floor(nextP.diff / 60)}j ${nextP.diff % 60}m lagi (${label})`;
    }

    function initGoldenDust() {
      const canvas = document.getElementById('dustCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w = canvas.width = window.innerWidth;
      let h = canvas.height = window.innerHeight;
      window.addEventListener('resize', () => { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; });

      const dots = Array.from({ length: 30 }, () => ({
        x: Math.random() * w, y: Math.random() * h, r: Math.random() * 2 + 1,
        vy: -Math.random() * 0.4 - 0.1, vx: (Math.random() - 0.5) * 0.2
      }));

      function anim() {
        ctx.clearRect(0, 0, w, h);
        dots.forEach(d => {
          d.y += d.vy; d.x += d.vx;
          if (d.y < 0) d.y = h;
          ctx.beginPath();
          ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 215, 0, 0.45)';
          ctx.fill();
        });
        requestAnimationFrame(anim);
      }
      anim();
    }

