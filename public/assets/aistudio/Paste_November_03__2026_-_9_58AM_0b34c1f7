    function triggerGoldenDustShower() {
      const canvas = document.getElementById('archiveGoldenDustShower');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width = canvas.parentElement.clientWidth || window.innerWidth;
      const h = canvas.height = canvas.parentElement.clientHeight || window.innerHeight;

      if (showerAnimationId) cancelAnimationFrame(showerAnimationId);

      const sparks = Array.from({ length: 65 }, () => ({
        x: Math.random() * w,
        y: -Math.random() * 80,
        r: Math.random() * 2.8 + 1,
        vy: Math.random() * 3.5 + 2,
        vx: (Math.random() - 0.5) * 1.5,
        alpha: Math.random() * 0.8 + 0.2,
        decay: Math.random() * 0.006 + 0.003
      }));

      function step() {
        ctx.clearRect(0, 0, w, h);
        let alive = false;
        sparks.forEach(s => {
          s.y += s.vy;
          s.x += s.vx;
          s.alpha -= s.decay;
          if (s.alpha > 0 && s.y < h) {
            alive = true;
            ctx.save();
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 215, 0, ${s.alpha})`;
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#fbbf24';
            ctx.fill();
            ctx.restore();
          }
        });
        if (alive) {
          showerAnimationId = requestAnimationFrame(step);
        } else {
          ctx.clearRect(0, 0, w, h);
        }
      }
      step();
    }

    function initArchiveSwipeGestures() {
      const drawer = document.getElementById('archiveDropside');
      if (!drawer) return;

      let touchStartX = 0;
      let touchStartY = 0;

      drawer.addEventListener('touchstart', (e) => {
        if (!e.touches || e.touches.length === 0) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      drawer.addEventListener('touchend', (e) => {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        const diffX = e.changedTouches[0].clientX - touchStartX;
        const diffY = e.changedTouches[0].clientY - touchStartY;

        if (Math.abs(diffX) > 60 && Math.abs(diffX) > Math.abs(diffY) * 1.3) {
          closeArchive(true);
          showToast('Kembali ke Menu Utama');
        }
      }, { passive: true });
    }

