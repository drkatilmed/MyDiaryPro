    async function getEntriesByPeriodWithMedia() {
      const dayNames = ['AHAD', 'ISNIN', 'SELASA', 'RABU', 'KHAMIS', 'JUMAAT', 'SABTU'];
      const monthNames = ['JANUARI', 'FEBRUARI', 'MAC', 'APRIL', 'MEI', 'JUN', 'JULAI', 'OGOS', 'SEPTEMBER', 'OKTOBER', 'NOVEMBER', 'DISEMBER'];
      const now = new Date();

      if (journalEntries.length === 0) {
        return [{
          dateTitle: `${dayNames[now.getDay()]}, ${now.getDate()} ${monthNames[now.getMonth()]} ${now.getFullYear()}`,
          title: "Kenangan & Perjalanan Hidup",
          content: "Setiap helaian hari ini menyimpan sejuta memori dan harapan yang tidak ternilai...",
          mood: "🌸 Tenang & Bahagia",
          timeStr: now.toLocaleTimeString('ms-MY', { hour: '2-digit', minute: '2-digit' }),
          photos: [],
          videoSrc: null
        }];
      }

      let daysCount = 7;
      if (selectedExportPeriod === '1day') daysCount = 1;
      else if (selectedExportPeriod === '30days') daysCount = 30;

      const cutoffTime = now.getTime() - (daysCount * 24 * 60 * 60 * 1000);
      let filtered = journalEntries.filter(e => new Date(e.timestamp).getTime() >= cutoffTime);

      if (filtered.length === 0) {
        filtered = journalEntries.slice(0, Math.min(daysCount, journalEntries.length));
      }

      const results = [];
      for (const item of filtered) {
        const d = new Date(item.timestamp);
        let videoData = null;
        if (item.video && item.video.startsWith('data:video')) {
          videoData = item.video;
        } else if (item.hasIndexedVideo) {
          const storedV = await getVideoFromIndexedDB(item.id);
          if (storedV) {
            if (storedV instanceof Blob) {
              videoData = await blobToDataURL(storedV);
            } else if (typeof storedV === 'string') {
              videoData = storedV;
            }
          }
        }

        results.push({
          dateTitle: `${dayNames[d.getDay()]}, ${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`,
          title: item.title,
          content: item.content,
          mood: item.mood,
          timeStr: d.toLocaleTimeString('ms-MY', { hour: '2-digit', minute: '2-digit' }),
          photos: item.photos || [],
          videoSrc: videoData
        });
      }
      return results;
    }

