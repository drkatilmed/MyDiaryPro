    function getSupportedMimeType() {
      const types = [
        'video/mp4;codecs=avc1',
        'video/mp4',
        'video/webm;codecs=vp8,opus',
        'video/webm;codecs=vp8',
        'video/webm'
      ];
      for (let t of types) {
        if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(t)) return t;
      }
      return '';
    }

    function startStreamVideoRecording() {
      if (!cameraMediaStream) return;
      videoRecordedChunks = [];
      const mime = getSupportedMimeType();
      const options = mime ? { mimeType: mime } : {};

      try {
        videoMediaRecorder = new MediaRecorder(cameraMediaStream, options);
      } catch (e) {
        try { videoMediaRecorder = new MediaRecorder(cameraMediaStream); }
        catch (err) {
          showToast('Rakaman video tidak disokong pada pelayar ini.');
          return;
        }
      }

      videoMediaRecorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) videoRecordedChunks.push(e.data);
      };

      videoMediaRecorder.onstop = () => {
        if (videoRecordedChunks.length === 0) return;
        const mimeType = videoMediaRecorder.mimeType || 'video/mp4';
        const blob = new Blob(videoRecordedChunks, { type: mimeType });
        attachedVideoBlob = blob;
        attachedVideo = URL.createObjectURL(blob);
        updateVideoSlotUI();
        stopCameraStream();
        showToast('Video 1:1 berjaya dirakam & sedia disimpan!');
      };

      videoMediaRecorder.start(250);
      isVideoRecording = true;
      videoRecSeconds = 0;
      document.getElementById('videoRecordingBadge').style.display = 'inline-flex';
      const btn = document.getElementById('modalActiveShutterBtn');
      btn.style.background = '#991b1b';
      document.getElementById('modalShutterIcon').className = 'fa-solid fa-stop';

      videoRecTimerInterval = setInterval(() => {
        videoRecSeconds++;
        const mins = String(Math.floor(videoRecSeconds / 60)).padStart(2, '0');
        const secs = String(videoRecSeconds % 60).padStart(2, '0');
        document.getElementById('videoRecTimer').textContent = `${mins}:${secs}`;
        if (videoRecSeconds >= 15) {
          stopStreamVideoRecording();
          showToast('Had rakaman video 15s dicapai.');
        }
      }, 1000);
    }

    function stopStreamVideoRecording() {
      if (videoMediaRecorder && isVideoRecording) {
        videoMediaRecorder.stop();
        isVideoRecording = false;
        clearInterval(videoRecTimerInterval);
        document.getElementById('videoRecordingBadge').style.display = 'none';
