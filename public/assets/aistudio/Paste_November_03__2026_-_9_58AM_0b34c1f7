    let dbInstance = null;
    function initIndexedMediaDB() {
      return new Promise((resolve) => {
        const req = indexedDB.open('MyDiaryMediaDB', 1);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains('videos')) {
            db.createObjectStore('videos', { keyPath: 'id' });
          }
        };
        req.onsuccess = (e) => {
          dbInstance = e.target.result;
          resolve(dbInstance);
        };
        req.onerror = () => resolve(null);
      });
    }

    async function saveVideoToIndexedDB(id, blobOrDataUrl) {
      if (!dbInstance) await initIndexedMediaDB();
      if (!dbInstance) return;
      return new Promise((resolve) => {
        const tx = dbInstance.transaction('videos', 'readwrite');
        const store = tx.objectStore('videos');
        store.put({ id: id, data: blobOrDataUrl });
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => resolve(false);
      });
    }

    async function getVideoFromIndexedDB(id) {
      if (!dbInstance) await initIndexedMediaDB();
      if (!dbInstance) return null;
      return new Promise((resolve) => {
        const tx = dbInstance.transaction('videos', 'readonly');
        const store = tx.objectStore('videos');
        const req = store.get(id);
        req.onsuccess = () => resolve(req.result ? req.result.data : null);
        req.onerror = () => resolve(null);
      });
    }

    async function deleteVideoFromIndexedDB(id) {
      if (!dbInstance) await initIndexedMediaDB();
      if (!dbInstance) return;
      const tx = dbInstance.transaction('videos', 'readwrite');
      tx.objectStore('videos').delete(id);
    }

    function blobToDataURL(blob) {
      return new Promise((resolve) => {
        if (!blob) return resolve('');
        if (typeof blob === 'string') return resolve(blob);
        const reader = new FileReader();
        reader.onloadend = () => resolve(reader.result);
        reader.onerror = () => resolve('');
        reader.readAsDataURL(blob);
      });
    }

