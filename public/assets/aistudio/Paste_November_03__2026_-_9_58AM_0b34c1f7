  <script>
    (function initEbookVideos() {
      const vPlayers = document.querySelectorAll('video[data-video-b64]');
      vPlayers.forEach(player => {
        const b64 = player.getAttribute('data-video-b64');
        if (!b64 || !b64.startsWith('data:')) return;
        try {
          const parts = b64.split(';base64,');
          const contentType = parts[0].replace('data:', '') || 'video/mp4';
          const byteCharacters = atob(parts[1]);
          const byteArrays = [];
          for (let offset = 0; offset < byteCharacters.length; offset += 512) {
            const slice = byteCharacters.slice(offset, offset + 512);
            const byteNumbers = new Array(slice.length);
            for (let i = 0; i < slice.length; i++) {
              byteNumbers[i] = slice.charCodeAt(i);
            }
            byteArrays.push(new Uint8Array(byteNumbers));
          }
          const blob = new Blob(byteArrays, { type: contentType });
          const blobUrl = URL.createObjectURL(blob);
          player.removeAttribute('data-video-b64');
          player.src = blobUrl;
          player.load();
        } catch (err) {
          console.warn('Gagal menukar video b64 ke Blob:', err);
        }
      });
    })();

    function makeDraggableAndPinchable(el) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let initialDistance = 0;
      let initialFontSize = 0;
      const bId = el.getAttribute('data-block-id');

      function getDistance(touches) {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }

      function getTargetFontElement() {
        if (bId === 'header') return el.querySelector('.date-title');
        if (bId === 'entries') return el.querySelector('.entry-text');
        if (bId === 'quote') return el.querySelector('.quote-bradley');
        return el;
      }

      function onTouchStart(e) {
        if (e.touches.length === 2) {
          isDragging = false;
          initialDistance = getDistance(e.touches);
          const target = getTargetFontElement();
          const computed = window.getComputedStyle(target);
          initialFontSize = parseFloat(computed.fontSize) || 12;
        } else if (e.touches.length === 1) {
          isDragging = true;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
        }
      }

      function onTouchMove(e) {
        if (e.touches.length === 2 && initialDistance > 0) {
          e.preventDefault();
          const curDist = getDistance(e.touches);
          const scale = curDist / initialDistance;
          let newPx = initialFontSize * scale;
          let newPt = newPx * 0.75;
          newPt = Math.max(6, Math.min(30, newPt));

          const target = getTargetFontElement();
          if (target) {
            target.style.fontSize = newPt + 'pt';
            try {
              window.parent.postMessage({ type: 'FONT_RESIZED', blockId: bId, newSize: newPt }, '*');
            } catch(err){}
          }
        } else if (isDragging && e.touches.length === 1) {
          const pt = e.touches[0];
          const dx = pt.clientX - startX;
          const dy = pt.clientY - startY;
          startX = pt.clientX;
          startY = pt.clientY;

          const style = window.getComputedStyle(el);
          const matrix = new DOMMatrixReadOnly(style.transform);
          el.style.transform = 'translate(' + (matrix.m41 + dx) + 'px, ' + (matrix.m42 + dy) + 'px)';
          try {
            window.parent.postMessage({ type: 'BLOCK_MOVED', blockId: bId, dx: dx, dy: dy }, '*');
          } catch(err){}
        }
      }

      function onTouchEnd(e) {
        if (e.touches.length < 2) initialDistance = 0;
        if (e.touches.length === 0) isDragging = false;
      }

      function onMouseDown(e) {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
      }

      function onMouseMove(e) {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        startX = e.clientX;
        startY = e.clientY;
        const style = window.getComputedStyle(el);
        const matrix = new DOMMatrixReadOnly(style.transform);
        el.style.transform = 'translate(' + (matrix.m41 + dx) + 'px, ' + (matrix.m42 + dy) + 'px)';
        try {
          window.parent.postMessage({ type: 'BLOCK_MOVED', blockId: bId, dx: dx, dy: dy }, '*');
        } catch(err){}
      }

      function onMouseUp() { isDragging = false; }

      el.addEventListener('mousedown', onMouseDown);
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);

      el.addEventListener('touchstart', onTouchStart, { passive: false });
      window.addEventListener('touchmove', onTouchMove, { passive: false });
      window.addEventListener('touchend', onTouchEnd);
    }

    document.querySelectorAll('.free-drag-block').forEach(makeDraggableAndPinchable);
  ${scriptTagClose}
</body>
