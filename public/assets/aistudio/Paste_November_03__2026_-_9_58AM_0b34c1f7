      const computedBackdrop = isZeroBox ? 'none !important' : 'blur(5px)';
      const computedBoxShadow = isZeroBox ? 'none !important' : '0 4px 18px rgba(0, 0, 0, 0.12)';
      const computedBorder = isZeroBox ? 'none !important' : `1px solid rgba(255, 255, 255, ${Math.min(1, boxOpacityValue + 0.25)})`;
      const computedPadding = isZeroBox ? '2px 4px' : '10px 16px';

      const pagesHtml = entriesArray.map((data, index) => {
        let mediaSection = '';
        let imgsHtml = '';
        if (includePhotos && data.photos && data.photos.length > 0) {
          imgsHtml = `<div class="ebook-media-grid">` + 
            data.photos.map(p => `<img src="${p}" class="ebook-photo-thumb" alt="Foto Halaman">`).join('') + 
          `</div>`;
        }
        let videoHtml = '';
        if (includeVideos && data.videoSrc) {
          const videoElementId = `ebook_video_${index}_${Date.now()}`;
          videoHtml = `<div class="ebook-video-wrapper">
            <video id="${videoElementId}" controls playsinline preload="auto" class="ebook-video-player" data-video-b64="${data.videoSrc}">
              <source src="${data.videoSrc}">
              Pelayar anda tidak menyokong pemain video ini.
            </video>
          </div>`;
        }
        if (imgsHtml || videoHtml) {
          mediaSection = `<div class="ebook-media-container">${imgsHtml}${videoHtml}</div>`;
        }

